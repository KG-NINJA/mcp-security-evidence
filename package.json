{
  "name": "mcp-security-evidence",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "sample": "npm run build && node scripts/sample.mjs",
    "dev": "wrangler dev --local",
    "test:interop": "node scripts/verify-interop.mjs",
    "verify:evidence": "npm run build --silent && node scripts/verify-evidence.mjs",
    "case-study": "npm run build && node scripts/retest-case-study.mjs",
    "lab:authz": "npm run build && node scripts/authorization-lab.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "wrangler": "4.86.0"
  }
}
